{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watcher",
  "version": "1.0.5",
  "identifier": "com.sundayteamwork.watcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watcher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost https://* http://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A local-first desktop API client",
    "longDescription": "Watcher organizes, executes, and inspects API requests without accounts or cloud services.",
    "homepage": "https://github.com/windht/watcher",
    "publisher": "windht",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDMDFGQjhDMTY3RDU1ODQKUldTRVZYMFdqUHNCYkNnRkpkY0pFNzJGMjdUZGZvZ20xYlQ3c3RvRnJlRmw0NVRyMFlQRGM5dXYK",
      "endpoints": [
        "https://github.com/windht/watcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
