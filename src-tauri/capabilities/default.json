{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Watcher window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    "opener:allow-open-url",
    "process:allow-restart",
    "updater:default"
  ]
}
